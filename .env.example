# Vercel Cron 鉴权（部署时在 Vercel 环境变量中设置，Vercel Cron 会自动携带 Bearer 头）
CRON_SECRET=your-random-cron-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_TABLE=node_daily_email_aq

# SMTP / 邮件发送（兼容 EMAIL_* 命名）
SMTP_USER=your-email@163.com
SMTP_PASS=your-email-smtp-auth-code
EMAIL_SERVICE=163
EMAIL_NAME=陪你一起看世界系列
TO_EMAIL=receiver@example.com
TO_TITLE=你的专属
RECEVICE_ERROR_EMAIL=error-receiver@example.com

# 业务配置
CITY=深圳
TOGETHER_TIME=2000-01-01
WEATHER_API_KEY=your-amap-web-api-key
WEATHER_CITY_ADCODE=440300
OPEN_RECORD=true
